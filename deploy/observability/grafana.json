{
  "uid": "grove-storage",
  "title": "Grove Storage",
  "description": "S3 request, local transfer, provider, maintenance and cached-state observations. Infrastructure CPU/memory and CNPG remain in their existing dashboards.",
  "tags": [
    "grove-storage",
    "storage"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Scraped targets",
      "type": "stat",
      "description": "Missing data means discovery is absent, not healthy.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(up{namespace=\"grove-storage\",cluster=~\"$cluster\",service=\"grove-storage-metrics\",endpoint=\"metrics\"})",
          "legendFormat": "targets",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "title": "S3 requests / second",
      "type": "stat",
      "description": "No traffic is not proof of provider availability.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(grove_http_requests_total{namespace=\"grove-storage\",cluster=~\"$cluster\",surface=\"s3\"}[$__rate_interval]))",
          "legendFormat": "requests",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "title": "S3 server-error ratio",
      "type": "stat",
      "description": "Supported operations only; intentional unsupported-operation 501 responses are excluded. No requests leaves this ratio undefined.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(grove_http_requests_total{namespace=\"grove-storage\",cluster=~\"$cluster\",surface=\"s3\",operation!=\"unsupported\",outcome=\"5xx\"}[$__rate_interval])) / sum(rate(grove_http_requests_total{namespace=\"grove-storage\",cluster=~\"$cluster\",surface=\"s3\",operation!=\"unsupported\",outcome=~\"[245]xx\"}[$__rate_interval]))",
          "legendFormat": "5xx ratio",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "title": "Snapshot availability",
      "type": "stat",
      "description": "0 means the latest sample failed; absent means not collected.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (source) (grove_snapshot_available{namespace=\"grove-storage\",cluster=~\"$cluster\"})",
          "legendFormat": "{{source}}",
          "range": false,
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "title": "HTTP response creation p95",
      "type": "timeseries",
      "description": "GET measures response creation, not download completion.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, surface, operation) (rate(grove_http_response_duration_seconds_bucket{namespace=\"grove-storage\",cluster=~\"$cluster\"}[$__rate_interval])))",
          "legendFormat": "{{surface}} / {{operation}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 6,
      "title": "Provider SDK send p95",
      "type": "timeseries",
      "description": "One logical SDK send includes internal retries. GET ends at headers/reader.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(grove_provider_duration_seconds_bucket{namespace=\"grove-storage\",cluster=~\"$cluster\"}[$__rate_interval])))",
          "legendFormat": "{{operation}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 7,
      "title": "Observed byte throughput",
      "type": "timeseries",
      "description": "Receive is DATA bytes reaching Grove; send is emitted frames, not client acknowledgement.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction) (rate(grove_transfer_bytes_total{namespace=\"grove-storage\",cluster=~\"$cluster\"}[$__rate_interval]))",
          "legendFormat": "{{direction}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 8,
      "title": "Transfer duration p95",
      "type": "timeseries",
      "description": "Receive ends at spool; send ends when expected bytes are emitted or the stream fails/drops.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, direction, outcome) (rate(grove_transfer_duration_seconds_bucket{namespace=\"grove-storage\",cluster=~\"$cluster\"}[$__rate_interval])))",
          "legendFormat": "{{direction}} / {{outcome}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 9,
      "title": "Incomplete and interrupted transfers",
      "type": "timeseries",
      "description": "These are not counted as successful transfers.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (direction, outcome) (increase(grove_transfers_total{namespace=\"grove-storage\",cluster=~\"$cluster\",outcome!=\"success\"}[$__rate_interval]))",
          "legendFormat": "{{direction}} / {{outcome}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 10,
      "title": "Provider and command errors",
      "type": "timeseries",
      "description": "MCP command results are independent of HTTP response status.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, outcome) (increase(grove_provider_requests_total{namespace=\"grove-storage\",cluster=~\"$cluster\",outcome=~\"error|interrupted\"}[$__rate_interval]))",
          "legendFormat": "provider {{operation}} / {{outcome}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum by (surface, operation, outcome) (increase(grove_management_operations_total{namespace=\"grove-storage\",cluster=~\"$cluster\",outcome!=\"success\"}[$__rate_interval]))",
          "legendFormat": "{{surface}} {{operation}} / {{outcome}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 11,
      "title": "Spool reservations and disk lengths",
      "type": "timeseries",
      "description": "Sampled every 60 seconds. Logical file lengths are not allocated blocks or node free space.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "grove_spool_reserved_bytes{namespace=\"grove-storage\",cluster=~\"$cluster\"}",
          "legendFormat": "{{pod}} reserved",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "grove_spool_budget_bytes{namespace=\"grove-storage\",cluster=~\"$cluster\"}",
          "legendFormat": "{{pod}} budget",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "expr": "grove_spool_file_bytes{namespace=\"grove-storage\",cluster=~\"$cluster\"}",
          "legendFormat": "{{pod}} file lengths",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 12,
      "title": "Transfer admission and slots",
      "type": "timeseries",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "grove_spool_slots{namespace=\"grove-storage\",cluster=~\"$cluster\"}",
          "legendFormat": "{{pod}} slots / {{state}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum by (reason) (increase(grove_spool_rejections_total{namespace=\"grove-storage\",cluster=~\"$cluster\"}[$__rate_interval]))",
          "legendFormat": "rejected / {{reason}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "expr": "grove_transfer_in_flight{namespace=\"grove-storage\",cluster=~\"$cluster\"}",
          "legendFormat": "{{pod}} in-flight / {{direction}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 13,
      "title": "Registered object bytes",
      "type": "timeseries",
      "description": "Shared DB snapshot: max across replicas, not sum. Not provider billing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (state) ((grove_objects_bytes{namespace=\"grove-storage\",cluster=~\"$cluster\"} and on (cluster, namespace, instance) (grove_snapshot_available{namespace=\"grove-storage\",cluster=~\"$cluster\",source=\"db\"} == 1 and (time() - grove_snapshot_last_success_timestamp_seconds{namespace=\"grove-storage\",cluster=~\"$cluster\",source=\"db\"} < 180))))",
          "legendFormat": "{{state}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 14,
      "title": "Recovery queues",
      "type": "timeseries",
      "description": "Shared DB state includes retry backoff. Check snapshot freshness before treating this as current.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (task) ((grove_recovery_queue_objects{namespace=\"grove-storage\",cluster=~\"$cluster\"} and on (cluster, namespace, instance) (grove_snapshot_available{namespace=\"grove-storage\",cluster=~\"$cluster\",source=\"db\"} == 1 and (time() - grove_snapshot_last_success_timestamp_seconds{namespace=\"grove-storage\",cluster=~\"$cluster\",source=\"db\"} < 180))))",
          "legendFormat": "{{task}} queued",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "max by (task) ((grove_recovery_queue_unknown_age_objects{namespace=\"grove-storage\",cluster=~\"$cluster\"} and on (cluster, namespace, instance) (grove_snapshot_available{namespace=\"grove-storage\",cluster=~\"$cluster\",source=\"db\"} == 1 and (time() - grove_snapshot_last_success_timestamp_seconds{namespace=\"grove-storage\",cluster=~\"$cluster\",source=\"db\"} < 180))))",
          "legendFormat": "{{task}} unknown age",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 15,
      "title": "Snapshot age",
      "type": "timeseries",
      "description": "Missing values mean a successful sample has not been observed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max by (pod, source) (grove_snapshot_last_success_timestamp_seconds{namespace=\"grove-storage\",cluster=~\"$cluster\"} > 0)",
          "legendFormat": "{{pod}} / {{source}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 16,
      "title": "Successful maintenance age",
      "type": "timeseries",
      "description": "Shared jobs use max across replicas; local cleanup is per Pod. Missing values mean no successful pass.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 44
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max by (worker, task) (grove_job_last_success_timestamp_seconds{namespace=\"grove-storage\",cluster=~\"$cluster\",task!=\"local_spool\"} > 0)",
          "legendFormat": "{{worker}} / {{task}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "time() - max by (pod, task) (grove_job_last_success_timestamp_seconds{namespace=\"grove-storage\",cluster=~\"$cluster\",task=\"local_spool\"} > 0)",
          "legendFormat": "{{pod}} / local spool",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 17,
      "title": "SQL pool occupancy",
      "type": "timeseries",
      "description": "Sampled total/idle/limit, not query latency or acquisition wait.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 52
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "grove_db_pool_connections{namespace=\"grove-storage\",cluster=~\"$cluster\"}",
          "legendFormat": "{{pod}} / {{pool}} / {{state}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 18,
      "title": "Retention and history failures",
      "type": "timeseries",
      "description": "Completed reports are observations, not an exact database ledger.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 52
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stream) (increase(grove_retention_rows_deleted_total{namespace=\"grove-storage\",cluster=~\"$cluster\"}[$__rate_interval]))",
          "legendFormat": "deleted / {{stream}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "expr": "sum by (stream) (increase(grove_retention_passes_total{namespace=\"grove-storage\",cluster=~\"$cluster\",outcome=\"error\"}[$__rate_interval]))",
          "legendFormat": "retention errors / {{stream}}",
          "range": true,
          "instant": false
        },
        {
          "refId": "C",
          "expr": "sum by (stream) (increase(grove_history_write_errors_total{namespace=\"grove-storage\",cluster=~\"$cluster\"}[$__rate_interval]))",
          "legendFormat": "history write failures / {{stream}}",
          "range": true,
          "instant": false
        }
      ]
    },
    {
      "id": 19,
