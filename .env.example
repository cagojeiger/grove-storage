# 설정은 전부 env다 (로컬은 이 파일을 .env로 복사, 배포는 TF가 만든 k8s Secret).
# 등록부(Storage·Client·서비스 키)는 DB에 저장하며 관리 API로 변경한다 (spec 01).

# 서버 설정 (미설정 시 로컬 기본값)
#GROVE_BIND=127.0.0.1:8080
#GROVE_LOG_FORMAT=pretty        # pretty | json
#GROVE_DATABASE_URL=postgres://grove:grove@127.0.0.1:55432/grove
#GROVE_DB_MAX_CONNECTIONS=20

# 암호화 루트 키 (필수). 아래 값은 로컬 개발 전용.
GROVE_ENC_ROOT_SECRET=grove-local-dev-enc-root-secret-32b!
# Initialize a local account with `grove-storage account init` before serving.
# 콘솔 세션 활성화: 별도 관리 origin의 HTTPS 프록시, 후행 / 제외 (spec 11).
# 객체 공개 URL과 다른 호스트를 사용하고 ingress는 원래 Host를 보존한다.
#GROVE_CONSOLE_ORIGIN=https://console.grove.example.com
#GROVE_ENC_KEY_ID=v1

# 암호화 키 회전 전환기에만 설정 (spec 01, 복호 전용 쌍)
#GROVE_ENC_ROOT_SECRET_PREV=
#GROVE_ENC_KEY_ID_PREV=

# reconciler tick 간격 (기본 60초) — 테스트에서만 줄인다.
# GROVE_RECONCILER_INTERVAL_SECS=60

# Management log retention in days (1..65535); 0 is rejected, not unlimited.
# Applied by the worker after restart; expired records are permanently deleted.
#GROVE_MANAGEMENT_AUDIT_RETENTION_DAYS=365
#GROVE_MANAGEMENT_SECURITY_RETENTION_DAYS=90
#GROVE_MANAGEMENT_INVOCATION_RETENTION_DAYS=30

# 중계 바이트 엔드포인트의 공개 베이스 URL — S3 storage에 force_relay를
# 등록하려면 필수. 로컬 개발은 서버 자신의 주소.
GROVE_PUBLIC_URL=http://127.0.0.1:8080

# multipart (spec 02) — 이 선언 크기를 넘으면 create가 part 서술자를 발급한다.
# part 크기는 create 시점 값이 업로드별로 동결된다 (벤더 규칙: 5MiB~5GiB).
#GROVE_MULTIPART_THRESHOLD_BYTES=268435456
#GROVE_PART_SIZE_BYTES=67108864

# S3 호환 표면 (spec 03)은 컨트롤과 같은 리스너(GROVE_BIND)에서 항상 켜진다 —
# 루트 path-style /{bucket}/{key}로 받고, 겹치는 이름(api·blobs·healthz·readyz)은
# 버킷으로 예약된다. 별도 리스너 env는 없다.

# /blobs와 S3 호환 표면의 CORS 허용 origin (쉼표 구분). 비어 있으면 CORS off.
#GROVE_S3_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173
